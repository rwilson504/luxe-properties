---
import Layout from '../../layouts/Layout.astro';
import { getCollection } from 'astro:content';

const entries = await getCollection('guide');
const sortedEntries = entries.sort((a, b) => b.data.date.getTime() - a.data.date.getTime());
---

<Layout title="Local Guide - Hocking Luxury Lodges" description="Curated tips, things to do, and seasonal inspiration for your Hocking Hills getaway — hiking trails, boating, fishing, stargazing, and more.">
  <div class="container py-4">
    <h1 class="mb-2" data-i18n="guide.title">Local Guide</h1>
    <p class="text-muted mb-4" data-i18n="guide.intro">Curated tips, things to do, and seasonal inspiration for your Hocking Hills getaway.</p>
    <div class="row">
      {sortedEntries.map((entry) => {
        const dateStr = entry.data.date.toLocaleDateString('en-US', {
          year: 'numeric',
          month: 'long',
          day: 'numeric',
        });
        return (
          <div class="col-md-6 col-lg-4 mb-4">
            <div class="card h-100">
              {entry.data.coverImage && (
                <img src={entry.data.coverImage} class="card-img-top" alt={entry.data.title} />
              )}
              <div class="card-body d-flex flex-column">
                <small class="text-muted mb-1">{dateStr}</small>
                <h5 class="card-title">
                  <span data-lang="en">{entry.data.title}</span>
                  {entry.data.title_es && <span data-lang="es">{entry.data.title_es}</span>}
                </h5>
                <p class="card-text">
                  <span data-lang="en">{entry.data.excerpt}</span>
                  {entry.data.excerpt_es && <span data-lang="es">{entry.data.excerpt_es}</span>}
                </p>
                <a href={`/guide/${entry.id}`} class="btn btn-primary mt-auto" data-i18n="guide.readMore">Read More</a>
              </div>
              {entry.data.tags && (
                <div class="card-footer">
                  {entry.data.tags.map((tag) => (
                    <span class="badge bg-secondary me-1">{tag}</span>
                  ))}
                </div>
              )}
            </div>
          </div>
        );
      })}
    </div>

    {sortedEntries.length === 0 && (
      <div class="text-center py-5">
        <p class="text-muted" data-i18n="guide.noEntries">No guide entries yet. Check back soon!</p>
      </div>
    )}
  </div>
</Layout>


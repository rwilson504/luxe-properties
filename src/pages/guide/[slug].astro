---
import Layout from '../../layouts/Layout.astro';
import { getCollection, render } from 'astro:content';

export async function getStaticPaths() {
  const entries = await getCollection('guide');
  return entries.map((entry) => ({
    params: { slug: entry.id },
    props: { entry },
  }));
}

const { entry } = Astro.props;
const { Content } = await render(entry);

const dateStr = entry.data.date.toLocaleDateString('en-US', {
  year: 'numeric',
  month: 'long',
  day: 'numeric',
});
---

<Layout title={`${entry.data.title} - Hocking Luxury Lodges`} description={entry.data.excerpt} ogType="article">
  <div class="container py-4">
    <nav aria-label="breadcrumb" class="mb-3">
      <ol class="breadcrumb">
        <li class="breadcrumb-item"><a href="/" data-i18n="guide.home">Home</a></li>
        <li class="breadcrumb-item"><a href="/guide" data-i18n="guide.breadcrumb">Local Guide</a></li>
        <li class="breadcrumb-item active" aria-current="page">{entry.data.title}</li>
      </ol>
    </nav>

    {entry.data.coverImage && (
      <img src={entry.data.coverImage} class="img-fluid mb-4 w-100" alt={entry.data.title} style="max-height: 400px; object-fit: cover;" />
    )}

    <h1>
      <span data-lang="en">{entry.data.title}</span>
      {entry.data.title_es && <span data-lang="es">{entry.data.title_es}</span>}
    </h1>
    <p class="text-muted">
      {dateStr}
      {entry.data.author && <span> &bull; {entry.data.author}</span>}
    </p>

    {entry.data.tags && (
      <div class="mb-4">
        {entry.data.tags.map((tag) => (
          <span class="badge bg-secondary me-1">{tag}</span>
        ))}
      </div>
    )}

    <article class="article-content">
      <Content />
    </article>

    <hr class="my-5" />
    <a href="/guide" class="btn btn-outline-primary" data-i18n="guide.backToGuide">&larr; Back to Local Guide</a>
  </div>
</Layout>
